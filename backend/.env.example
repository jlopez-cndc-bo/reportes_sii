# Copie este archivo a .env y complete con sus credenciales de solo lectura.
# DSN admite "host:puerto/servicio" o un alias de tnsnames.
ORACLE_USER=usuario_lectura
ORACLE_PASSWORD=su_clave
ORACLE_DSN=host:1521/servicio

# Modo thick sólo si necesita el cliente Oracle (por defecto thin, sin cliente).
# ORACLE_THICK=0
# ORACLE_LIB_DIR=

# Pool
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4

# Orígenes CORS permitidos (frontend en desarrollo)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autenticación HTTP Basic OPCIONAL: si define ambas, protege toda la API.
# Déjelas vacías para acceso sin credenciales (uso interno de solo lectura).
# APP_USER=
# APP_PASSWORD=
